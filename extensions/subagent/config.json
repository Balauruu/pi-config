{
  "toolDescriptionMode": "compact",
  "artifactDir": "session",
  "globalConcurrencyLimit": 8,
  "maxSubagentDepth": 2,
  "parallel": {
    "maxTasks": 8,
    "concurrency": 8
  },
  "control": {
    "needsAttentionAfterMs": 300000,
    "activeNoticeAfterMs": 600000,
    "failedToolAttemptsBeforeAttention": 3,
    "notifyOn": ["needs_attention"],
    "notifyChannels": ["event", "async", "intercom"]
  }
}
