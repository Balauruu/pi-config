{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "../../../../data/AI/PI/@HARNESS-BUILD/packages/better-autocomplete",
    "npm:pi-zentui",
    "git:github.com/Balauruu/pi-interactive-subagents-herdr@cb8b76108bab03597cd7a617b5d232cbd1c1ae17",
    "npm:pi-observational-memory",
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:pi-agent-browser-native",
    "npm:pi-condense",
    "npm:@pi-archimedes/session-name",
    "npm:pi-tool-repair",
    "npm:@agwab/pi-workflow"
  ],
  "contextPrune": {
    "enabled": true,
    "summarizerModel": "openai-codex/gpt-5.6-luna",
    "summarizerThinking": "high",
    "protectedTools": [
      "ask_user_question"
    ],
    "protectedPaths": [
      "**/skills/**/*.md",
      "**/SKILL.md",
      "**/AGENTS.md",
      "**/gauntlet-overrides.md",
      "**/.pi/settings.json",
      "/home/balauru/.pi/agent/settings.json"
    ]
  },
  "observational-memory": {
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.68,
    "models": {
      "observer": {
        "provider": "openai-codex",
        "id": "gpt-5.6-luna",
        "thinking": "xhigh"
      },
      "consolidator": {
        "provider": "openai-codex",
        "id": "gpt-5.6-luna",
        "thinking": "max"
      }
    }
  }
}